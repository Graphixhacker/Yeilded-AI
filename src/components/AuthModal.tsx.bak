import React, { useState, useEffect } from 'react';
import { useSwipeDismiss } from '../hooks/useSwipeDismiss';
import { api } from '../services/api';
import { User } from '../types';
import { Shield, X, Mail, Lock, User as UserIcon, Sparkles, CheckCircle2, ArrowRight, AlertCircle, Info } from 'lucide-react';

export interface AuthModalProps {
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: (user: User) => void;
  onAuthSuccess?: (user: User) => void;
  initialMode?: 'signin' | 'signup';
  onOpenPricing?: () => void;
}

export const AuthModal: React.FC<AuthModalProps> = ({
  isOpen,
  onClose = () => {},
  onSuccess = (_user: User) => {},
  onAuthSuccess = (_user: User) => {},
  initialMode = 'signin',
  onOpenPricing
}) => {
  const [mode, setMode] = useState<'signin' | 'signup'>(initialMode);
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [affiliateCode, setAffiliateCode] = useState('');
  const [name, setName] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
    const [registrationSuccess, setRegistrationSuccess] = useState(false);

  // Sync mode whenever initialMode or isOpen changes
  useEffect(() => {
    if (isOpen) {
      setMode(initialMode);
      setError(null);
            setRegistrationSuccess(false);
    }
  }, [initialMode, isOpen]);

  const { offset, isSwiping, touchHandlers } = useSwipeDismiss({
    onDismiss: onClose,
    direction: 'down',
    threshold: 60,
    enabled: isOpen
  });

  if (!isOpen) return null;

  const handleAuthComplete = (authedUser: User) => {
    setRegistrationSuccess(true);
    setLoading(false);

    // Call callbacks safely
    try {
      if (typeof onSuccess === 'function') {
        onSuccess(authedUser);
      }
    } catch (e) {
      console.warn('onSuccess callback error:', e);
    }

    try {
      if (typeof onAuthSuccess === 'function') {
        onAuthSuccess(authedUser);
      }
    } catch (e) {
      console.warn('onAuthSuccess callback error:', e);
    }

    // Immediately trigger close to avoid delegate being stuck on modal
    setTimeout(() => {
      onClose();
    }, 250);
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);
    
    const cleanEmail = email.trim().toLowerCase();
    const cleanPassword = password.trim();

    if (!cleanEmail || !cleanPassword) {
      setError('Please provide both email and password.');
      return;
    }

    if (mode === 'signup' && cleanPassword.length < 6) {
      setError('Password must be at least 6 characters long.');
      return;
    }

    setLoading(true);

    try {
      if (mode === 'signup') {
        const delegateName = name.trim() || cleanEmail.split('@')[0];
        const res = await api.register(cleanEmail, delegateName, cleanPassword, affiliateCode);
        handleAuthComplete(res.user);
      } else {
        const res = await api.login(cleanEmail, cleanPassword);
        handleAuthComplete(res.user);
      }
    } catch (err: any) {
      setLoading(false);
      const msg = err.message || 'Authentication failed. Please verify credentials.';
      if (msg.includes('already exists')) {
        setError('An account with this email already exists. Switching to Sign In...');
        setTimeout(() => {
          setMode('signin');
        }, 1200);
      } else {
        setError(msg);
      }
    }
  };

  
  


  return (
    <div 
      id="auth-modal-backdrop"
      onClick={(e) => {
        if (e.target === e.currentTarget) onClose();
      }}
      className="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-black/70 backdrop-blur-xs animate-in fade-in duration-200"
    >
      <div 
        id="auth-modal-dialog"
        {...touchHandlers}
        style={{
          transform: offset.y > 0 ? `translateY(${offset.y}px)` : undefined,
          transition: isSwiping ? 'none' : 'transform 0.2s ease-out'
        }}
        className="bg-white dark:bg-[#0c1c33] rounded-2xl w-[96%] max-w-md max-h-[90vh] flex flex-col shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden relative"
      >
        {/* Swipe-to-dismiss pull handle indicator for mobile */}
        <div className="sm:hidden flex justify-center pt-2 pb-1 bg-[#0B1F3A] cursor-grab active:cursor-grabbing border-b border-[#D4AF37]/10">
          <div className="w-12 h-1 rounded-full bg-slate-400/60" />
        </div>

        {/* Navy & Gold Header */}
        <div className="bg-[#0B1F3A] text-white p-4 sm:p-5 relative border-b border-[#D4AF37]/30 shrink-0">
          <button
            id="close-auth-modal-btn"
            onClick={onClose}
            aria-label="Close authentication modal"
            className="absolute top-3.5 right-3.5 text-slate-300 hover:text-white p-2 rounded-xl hover:bg-white/10 transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center"
          >
            <X className="w-5 h-5" />
          </button>

          <div className="flex items-center gap-2 text-[#D4AF37] mb-1.5 text-xs font-semibold tracking-wider uppercase">
            <Shield className="w-4 h-4 text-[#D4AF37]" />
            <span>MODEL UNITED NATIONS CREDENTIALS</span>
          </div>

          <h2 className="text-lg sm:text-xl font-bold text-white tracking-tight">
            {mode === 'signin' ? 'Welcome Back, Delegate' : 'Register Delegation Account'}
          </h2>
          <p className="text-xs text-slate-300 mt-0.5 leading-relaxed">
            Securely save position papers, speech drafts, and active conference passes across devices.
          </p>
        </div>

        {/* Scrollable Form Body */}
        <div className="p-4 sm:p-6 overflow-y-auto flex-1">
          {registrationSuccess && (
            <div className="mb-4 p-3.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 flex items-center gap-2.5 animate-in fade-in">
              <CheckCircle2 className="w-5 h-5 text-emerald-600 dark:text-emerald-400 shrink-0" />
              <div className="text-xs">
                <p className="font-bold text-emerald-900 dark:text-emerald-200">Credentials Authenticated</p>
                <p className="text-emerald-700 dark:text-emerald-400">Loading your Model UN Diplomatic Suite...</p>
              </div>
            </div>
          )}

          {error && !registrationSuccess && (
            <div className="mb-4 p-3 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-xs font-medium text-rose-800 dark:text-rose-300 flex items-start gap-2">
              <AlertCircle className="w-4 h-4 text-rose-600 shrink-0 mt-0.5" />
              <span>{error}</span>
            </div>
          )}

          

          {/* Instant Demo Delegate Sign-In Button */}

          <form onSubmit={handleSubmit} className="space-y-3.5">
            {mode === 'signup' && (
              <div>
                <label className="block text-xs font-semibold text-slate-800 dark:text-slate-200 mb-1">
                  Referral / Affiliate Code (Optional)
                </label>
                <div className="relative">
                  <input
                    type="text"
                    value={affiliateCode}
                    onChange={(e) => setAffiliateCode(e.target.value)}
                    placeholder="e.g. MUN2026"
                    className="w-full min-h-[44px] px-3 py-2.5 text-base sm:text-sm border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-[#0B1F3A] dark:focus:ring-[#D4AF37] bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 placeholder-slate-400"
                  />
                </div>
              </div>
            )}

            {mode === 'signup' && (
              <div>
                <label className="block text-xs font-semibold text-slate-800 dark:text-slate-200 mb-1">
                  Full Name / Diplomatic Title
                </label>
                <div className="relative">
                  <UserIcon className="w-4 h-4 text-slate-400 absolute left-3 top-3.5" />
                  <input
                    id="auth-name-input"
                    type="text"
                    required
                    value={name}
                    onChange={(e) => setName(e.target.value)}
                    placeholder="e.g. Ambassador Fatima Tariq"
                    className="w-full min-h-[44px] pl-9 pr-3 py-2.5 text-base sm:text-sm border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-[#0B1F3A] dark:focus:ring-[#D4AF37] bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 placeholder-slate-400"
                  />
                </div>
              </div>
            )}

            <div>
              <label className="block text-xs font-semibold text-slate-800 dark:text-slate-200 mb-1">
                Email Address
              </label>
              <div className="relative">
                <Mail className="w-4 h-4 text-slate-400 absolute left-3 top-3.5" />
                <input
                  id="auth-email-input"
                  type="email"
                  required
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                  placeholder="delegate@school.edu"
                  className="w-full min-h-[44px] pl-9 pr-3 py-2.5 text-base sm:text-sm border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-[#0B1F3A] dark:focus:ring-[#D4AF37] bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 placeholder-slate-400"
                />
              </div>
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-800 dark:text-slate-200 mb-1">
                Password {mode === 'signup' && <span className="text-slate-400 font-normal">(min 6 characters)</span>}
              </label>
              <div className="relative">
                <Lock className="w-4 h-4 text-slate-400 absolute left-3 top-3.5" />
                <input
                  id="auth-password-input"
                  type="password"
                  required
                  minLength={6}
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  placeholder="••••••••"
                  className="w-full min-h-[44px] pl-9 pr-3 py-2.5 text-base sm:text-sm border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-[#0B1F3A] dark:focus:ring-[#D4AF37] bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 placeholder-slate-400"
                />
              </div>
            </div>

            <button
              id="auth-submit-btn"
              type="submit"
              disabled={loading}
              className="w-full min-h-[44px] py-3 bg-[#0B1F3A] hover:bg-[#132c4f] text-[#D4AF37] font-bold text-xs sm:text-sm rounded-xl transition-all shadow-md flex items-center justify-center gap-2 mt-4 border border-[#D4AF37]/30 disabled:opacity-60"
            >
              <span>
                {loading
                  ? 'Authenticating Credentials...'
                  : mode === 'signin'
                  ? 'Sign In to Conference Suite'
                  : 'Create Free Account & Enter Suite'}
              </span>
              <ArrowRight className="w-4 h-4" />
            </button>
          </form>

          <div className="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 text-center">
            {mode === 'signin' ? (
              <p className="text-xs text-slate-500 dark:text-slate-400">
                New to Yeilded?{' '}
                <button
                  id="switch-to-signup-btn"
                  type="button"
                  onClick={() => {
                    setMode('signup');
                    setError(null);
                                      }}
                  className="font-bold text-[#0B1F3A] dark:text-[#D4AF37] hover:underline min-h-[36px] inline-flex items-center px-1"
                >
                  Create free account
                </button>
              </p>
            ) : (
              <p className="text-xs text-slate-500 dark:text-slate-400">
                Already registered?{' '}
                <button
                  id="switch-to-signin-btn"
                  type="button"
                  onClick={() => {
                    setMode('signin');
                    setError(null);
                                      }}
                  className="font-bold text-[#0B1F3A] dark:text-[#D4AF37] hover:underline min-h-[36px] inline-flex items-center px-1"
                >
                  Sign in to existing account
                </button>
              </p>
            )}
          </div>
        </div>
      </div>
    </div>
  );
};
