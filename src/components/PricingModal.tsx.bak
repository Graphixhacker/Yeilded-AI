import React, { useState, useEffect } from 'react';
import { User, UserTier, Currency, PricingPlan } from '../types';
import { X, CheckCircle2, Zap, Shield, Sparkles, Building, Smartphone, CreditCard, Upload } from 'lucide-react';
import { api } from '../services/api';

interface PricingModalProps {
  isOpen: boolean;
  onClose: () => void;
  user: User | null;
  onOpenAuth: () => void;
  currency: Currency;
  onToggleCurrency: () => void;
  onPassActivated: (user: User) => void;
}

const pricingData: Record<string, any> = {
  free: {
    id: 'free',
    name: 'Observer Pass',
    price: 'Free',
    rawAmount: 0,
    durationLabel: 'Forever',
    description: 'Basic access to familiarize yourself with MUN frameworks.',
    features: [
      'Basic RoP Assistant',
      'UN Country Database',
      '3 AI Generations / Day'
    ],
    limitations: [
      'Watermarked Exports',
      'No Crisis Simulator',
      'Standard AI Speed'
    ]
  },
  '1week': {
    id: '1week',
    name: 'Conference Pass',
    badge: 'CONFERENCE READY',
    price: 'PKR 499',
    priceUSD: '$5.00',
    rawAmount: 499,
    durationLabel: '1-Week Access',
    popular: true,
    description: 'Unlimited powerhouse tools strictly for your 1-week conference period.',
    features: [
      'Unlimited AI Speech Generation',
      'Unlimited Position Papers',
      'Unlimited Crisis Directives',
      'Live Debate Sparring',
      'Priority AI Speed',
      'No Watermarks'
    ]
  },
  monthly: {
    id: 'monthly',
    name: 'Diplomat Pro',
    price: 'PKR 1,499',
    priceUSD: '$7.99',
    rawAmount: 1499,
    durationLabel: 'Per Month',
    description: 'For circuit regulars, society board members, and Secretariat.',
    features: [
      'Everything in Conference Pass',
      'Save Unlimited Drafts',
      'Access to Historical Archives',
      'Custom Committee Setup',
      'Cancel Anytime'
    ]
  }
};

export function PricingModal({ isOpen, onClose, user, onOpenAuth, currency, onToggleCurrency, onPassActivated }: PricingModalProps) {
  const [selectedTier, setSelectedTier] = useState<UserTier>('1week');
  const [paymentStep, setPaymentStep] = useState<'plans' | 'checkout' | 'success'>('plans');
  const [paymentGateway, setPaymentGateway] = useState<'bank' | 'jazzcash'>('bank');

  // Prevent background scroll when open
  useEffect(() => {
    if (isOpen) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = '';
      setTimeout(() => {
        setPaymentStep('plans');
      }, 300);
    }
    return () => {
      document.body.style.overflow = '';
    };
  }, [isOpen]);

  if (!isOpen) return null;

  const handleClose = () => {
    onClose();
  };

  const currentPricingData = {
    ...pricingData,
    '1week': {
      ...pricingData['1week'],
      price: currency === 'PKR' ? 'PKR 499' : '$5.00'
    },
    monthly: {
      ...pricingData['monthly'],
      price: currency === 'PKR' ? 'PKR 1,499' : '$7.99'
    }
  };

  return (
    <div 
      onClick={(e) => {
        if (e.target === e.currentTarget) handleClose();
      }}
      className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs animate-in fade-in duration-200"
    >
      <div 
        className="bg-white dark:bg-[#060f1d] w-full max-w-4xl rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]"
      >
        <div className="flex justify-between items-center p-5 border-b border-slate-200 dark:border-slate-800">
          <div className="flex items-center gap-2">
            <Sparkles className="w-5 h-5 text-[#D4AF37]" />
            <h2 className="text-lg font-bold text-[#0B1F3A] dark:text-[#D4AF37]">Upgrade Access</h2>
          </div>
          <button 
            onClick={handleClose}
            className="p-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 rounded-full transition-colors"
          >
            <X className="w-5 h-5 text-slate-500" />
          </button>
        </div>

        <div className="flex-1 overflow-y-auto p-4 sm:p-6">
          {paymentStep === 'plans' && (
            <>
              <div className="text-center mb-8">
                <h3 className="text-2xl font-bold text-[#0B1F3A] dark:text-white mb-2">
                  Unleash Your Diplomatic Potential
                </h3>
                <p className="text-sm text-slate-600 dark:text-slate-400 max-w-lg mx-auto">
                  Upgrade your pass to remove AI limits, unlock the Crisis Simulator, and gain a definitive edge in committee.
                </p>
                <div className="mt-4 flex justify-center">
                  <div className="inline-flex items-center bg-slate-100 dark:bg-slate-800 p-1 rounded-lg">
                    <button 
                      onClick={() => currency !== 'PKR' && onToggleCurrency()}
                      className={`px-3 py-1.5 text-xs font-bold rounded-md transition-colors ${currency === 'PKR' ? 'bg-white dark:bg-slate-700 text-[#0B1F3A] dark:text-[#D4AF37] shadow-sm' : 'text-slate-500'}`}
                    >
                      PKR
                    </button>
                    <button 
                      onClick={() => currency !== 'USD' && onToggleCurrency()}
                      className={`px-3 py-1.5 text-xs font-bold rounded-md transition-colors ${currency === 'USD' ? 'bg-white dark:bg-slate-700 text-[#0B1F3A] dark:text-[#D4AF37] shadow-sm' : 'text-slate-500'}`}
                    >
                      USD
                    </button>
                  </div>
                </div>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
                {Object.values(currentPricingData).map(plan => (
                  <div 
                    key={plan.id}
                    onClick={() => plan.id !== 'free' && setSelectedTier(plan.id as UserTier)}
                    className={`relative p-6 rounded-2xl border-2 transition-all cursor-pointer flex flex-col ${
                      plan.id === 'free' 
                        ? 'border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/50 opacity-70 hover:opacity-100 cursor-default'
                        : selectedTier === plan.id
                          ? 'border-[#0B1F3A] dark:border-[#D4AF37] bg-blue-50/50 dark:bg-[#071326] scale-[1.02] shadow-xl'
                          : 'border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0a1628] hover:border-slate-300 dark:hover:border-slate-700 hover:scale-[1.01]'
                    }`}
                  >
                    {plan.popular && (
                      <div className="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#D4AF37] text-[#0B1F3A] text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-wider shadow-md">
                        {plan.badge || 'Most Popular'}
                      </div>
                    )}
                    
                    <div className="text-center mb-6">
                      <div className="text-sm font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">{plan.name}</div>
                      <div className="flex items-end justify-center gap-1 mb-1">
                        <span className="text-3xl font-black text-[#0B1F3A] dark:text-white">{plan.price}</span>
                      </div>
                      <div className="text-xs text-slate-500">{plan.durationLabel}</div>
                    </div>

                    <p className="text-xs text-slate-600 dark:text-slate-300 mb-6 text-center h-10">
                      {plan.description}
                    </p>

                    <div className="flex-1">
                      <ul className="space-y-3 mb-6">
                        {plan.features.map((f: string, i: number) => (
                          <li key={i} className="flex items-start gap-2 text-xs text-slate-700 dark:text-slate-200">
                            <CheckCircle2 className={`w-4 h-4 shrink-0 ${plan.id === 'free' ? 'text-slate-400' : 'text-[#D4AF37]'}`} />
                            <span className="leading-tight">{f}</span>
                          </li>
                        ))}
                        {plan.limitations?.map((l: string, i: number) => (
                          <li key={`lim-${i}`} className="flex items-start gap-2 text-xs text-slate-400">
                            <X className="w-4 h-4 shrink-0 text-slate-300 dark:text-slate-600" />
                            <span className="leading-tight line-through">{l}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <div className="mt-auto pt-4 border-t border-slate-100 dark:border-slate-800/50">
                      {plan.id === 'free' ? (
                        <button disabled className="w-full py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-500 text-xs font-bold">
                          Current Plan
                        </button>
                      ) : (
                        <button
                          onClick={() => {
                            if (!user) {
                              onOpenAuth();
                            } else {
                              setSelectedTier(plan.id as UserTier);
                              setPaymentStep('checkout');
                            }
                          }}
                          className={`w-full py-2.5 rounded-xl text-xs font-bold transition-colors ${
                            selectedTier === plan.id
                              ? 'bg-[#0B1F3A] text-[#D4AF37] hover:bg-[#132c4f] shadow-md'
                              : 'bg-slate-100 dark:bg-slate-800 text-[#0B1F3A] dark:text-white hover:bg-slate-200 dark:hover:bg-slate-700'
                          }`}
                        >
                          Select {plan.name}
                        </button>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </>
          )}

          {paymentStep === 'checkout' && (
            <div className="max-w-2xl mx-auto space-y-6">
              <div className="text-center mb-6">
                <h3 className="text-xl font-bold text-[#0B1F3A] dark:text-white">Secure Checkout</h3>
                <p className="text-xs text-slate-500">You are upgrading to the <strong className="text-[#D4AF37]">{currentPricingData[selectedTier].name}</strong> ({currentPricingData[selectedTier].price})</p>
              </div>

              <div className="space-y-4">
                <label className="block text-sm font-bold text-[#0B1F3A] dark:text-[#D4AF37]">
                  Select Payment Method
                </label>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  {/* Bank Transfer */}
                  <button
                    id="btn-gateway-bank"
                    type="button"
                    onClick={() => setPaymentGateway('bank')}
                    className={`p-3 min-h-[44px] rounded-xl border text-left transition-all ${
                      paymentGateway === 'bank'
                        ? 'border-[#0B1F3A] dark:border-[#D4AF37] bg-blue-50/70 dark:bg-[#07172e] ring-2 ring-[#0B1F3A]/20 dark:ring-[#D4AF37]/30'
                        : 'border-slate-200 dark:border-slate-800 hover:border-slate-300 bg-white dark:bg-[#071326]'
                    }`}
                  >
                    <div className="flex items-center justify-between mb-1">
                      <div className="font-bold text-xs text-slate-800 dark:text-slate-200 flex items-center gap-2">
                        <Building className="w-4 h-4" /> Bank Transfer
                      </div>
                      {paymentGateway === 'bank' && <CheckCircle2 className="w-4 h-4 text-[#D4AF37]" />}
                    </div>
                    <div className="text-[10px] text-slate-500 dark:text-slate-400">Bank Alfalah</div>
                  </button>

                  {/* JazzCash */}
                  <button
                    id="btn-gateway-jazzcash"
                    type="button"
                    onClick={() => setPaymentGateway('jazzcash')}
                    className={`p-3 min-h-[44px] rounded-xl border text-left transition-all ${
                      paymentGateway === 'jazzcash'
                        ? 'border-amber-600 dark:border-amber-500 bg-amber-50/70 dark:bg-amber-950/30 ring-2 ring-amber-600/20'
                        : 'border-slate-200 dark:border-slate-800 hover:border-slate-300 bg-white dark:bg-[#071326]'
                    }`}
                  >
                    <div className="flex items-center justify-between mb-1">
                      <div className="font-bold text-xs text-slate-800 dark:text-slate-200 flex items-center gap-2">
                        <Smartphone className="w-4 h-4 text-amber-500" /> JazzCash
                      </div>
                      {paymentGateway === 'jazzcash' && <CheckCircle2 className="w-4 h-4 text-amber-500" />}
                    </div>
                    <div className="text-[10px] text-slate-500 dark:text-slate-400">Mobile Wallet</div>
                  </button>
                </div>
              </div>

              {/* Gateway Input Fields */}
              <div className="space-y-4 p-5 rounded-xl bg-slate-50 dark:bg-[#071326] border border-slate-200 dark:border-slate-800">
                <div className="text-sm font-bold text-[#0B1F3A] dark:text-[#D4AF37] mb-2 border-b border-slate-200 dark:border-slate-700 pb-2">
                  Payment Instructions
                </div>
                
                {paymentGateway === 'bank' && (
                  <div className="space-y-3 text-sm text-slate-700 dark:text-slate-300">
                    <p>Please transfer exactly <strong className="text-[#0B1F3A] dark:text-white">{currentPricingData[selectedTier].price}</strong> to the following bank account:</p>
                    <div className="bg-white dark:bg-slate-900 p-4 rounded-lg border border-slate-200 dark:border-slate-700 font-mono text-sm shadow-inner space-y-2">
                      <div className="flex justify-between items-center"><span className="text-slate-500">Bank:</span> <span className="font-bold">Bank Alfalah</span></div>
                      <div className="flex justify-between items-center"><span className="text-slate-500">IBAN / A/C:</span> <span className="font-bold tracking-wider text-emerald-600 dark:text-emerald-400">PK33ALFH0304001005709819</span></div>
                    </div>
                  </div>
                )}

                {paymentGateway === 'jazzcash' && (
                  <div className="space-y-3 text-sm text-slate-700 dark:text-slate-300">
                    <p>Please transfer exactly <strong className="text-[#0B1F3A] dark:text-white">{currentPricingData[selectedTier].price}</strong> to the following JazzCash account:</p>
                    <div className="bg-white dark:bg-slate-900 p-4 rounded-lg border border-slate-200 dark:border-slate-700 font-mono text-sm shadow-inner space-y-2">
                      <div className="flex justify-between items-center"><span className="text-slate-500">JazzCash No:</span> <span className="font-bold tracking-wider text-amber-600 dark:text-amber-400">0312-2421899</span></div>
                    </div>
                  </div>
                )}

                <div className="pt-4 mt-4 border-t border-slate-200 dark:border-slate-700">
                  <div className="flex gap-3 mb-4 p-3 bg-amber-50 dark:bg-amber-950/30 text-amber-800 dark:text-amber-200 rounded-lg text-xs border border-amber-200 dark:border-amber-800">
                    <Upload className="w-5 h-5 shrink-0" />
                    <p className="leading-relaxed">
                      After making the payment, send a screenshot of the receipt via WhatsApp. 
                      Include your registered email address (<strong className="font-bold">{user?.email}</strong>) so we can manually activate your pass.
                    </p>
                  </div>
                  <a 
                    href="https://wa.me/923122421899" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    className="w-full flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#128C7E] text-white py-3.5 px-4 rounded-xl font-bold text-sm shadow-md transition-all hover:-translate-y-0.5"
                  >
                    Send Receipt on WhatsApp
                  </a>
                </div>
              </div>

              {/* Action buttons */}
              <div className="flex flex-col-reverse sm:flex-row items-center justify-between gap-3 pt-4 border-t border-slate-200 dark:border-slate-800">
                <button
                  type="button"
                  onClick={() => setPaymentStep('plans')}
                  className="w-full sm:w-auto min-h-[44px] text-xs font-bold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 py-2.5 px-4 rounded-xl"
                >
                  ← Back to Plans
                </button>
                <button
                  type="button"
                  onClick={() => {
                    alert("Instructions shown! Please ensure you send the receipt on WhatsApp so our team can activate your pass.");
                    handleClose();
                  }}
                  className="w-full sm:w-auto min-h-[44px] px-6 py-3 bg-[#0B1F3A] hover:bg-[#132c4f] text-[#D4AF37] font-bold text-xs rounded-xl shadow-lg transition-all"
                >
                  Close Window
                </button>
              </div>
            </div>
          )}

        </div>
      </div>
    </div>
  );
}
