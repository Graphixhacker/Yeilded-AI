import React, { useState } from 'react';
import { ErrorAlert } from "../ErrorAlert";

import { DelegateContext, User, CrisisNote } from '../../types';
import { api } from '../../services/api';
import { exportDocumentToPDF, copyToClipboard } from '../../utils/exportUtils';
import {
  Flame,
  Sparkles,
  Send,
  AlertCircle,
  EyeOff,
  Radio,
  FileText,
  CheckCircle2,
  Lock,
  Download,
  Copy,
  Check
} from 'lucide-react';

interface CrisisSimulatorTabProps {
  context: DelegateContext;
  user: User | null;
  onOpenAuth: () => void;
  onOpenPricing: () => void;
  onUpdateUser: (u: User) => void;
}

export const CrisisSimulatorTab: React.FC<CrisisSimulatorTabProps> = ({
  context,
  user,
  onOpenAuth,
  onOpenPricing,
  onUpdateUser
}) => {
  const [recipient, setRecipient] = useState('Director of Military Intelligence / Naval Command');
  const [classification, setClassification] = useState<'public' | 'covert' | 'directive'>('covert');
  const [objective, setObjective] = useState('Establish clandestine electronic interception listening post on sovereign perimeter.');
  const [actionDetails, setActionDetails] = useState(
    'Deploy four naval reconnaissance vessels disguised as civilian oceanographic research trawlers. Tap submarine fiber communication cables in international waters adjacent to the contentious strait without active radar pinging.'
  );
  const [resourcesNeeded, setResourcesNeeded] = useState(
    '2x Deep-sea submersible drones, 40 specialist cryptographers, encrypted diplomatic pouch routing via friendly third-party consulate.'
  );

  const [isSimulating, setIsSimulating] = useState(false);
  const [feedback, setFeedback] = useState<any>(null);
  const [copied, setCopied] = useState(false);
  const [errorMsg, setErrorMsg] = useState<string | null>(null);

  const isFree = !user || user.tier === 'free';
  const isFreeLimitHit = isFree && (user?.generationsUsed || 0) >= 3;

  const handleRunSimulation = async () => {
    if (!user) {
      onOpenAuth();
      return;
    }

    if (isFreeLimitHit) {
      onOpenPricing();
      return;
    }

    setIsSimulating(true);
    setErrorMsg(null);

    const notePayload: Partial<CrisisNote> = {
      recipient,
      classification,
      objective,
      actionDetails,
      resourcesNeeded
    };

    try {
      const res = await api.generateAI('crisis-analyze', {
        note: notePayload,
        language: context.language || 'English'
      });

      if (res.result) {
        setFeedback(res.result);
      }
      if (res.user) {
        onUpdateUser(res.user);
      }
    } catch (err: any) {
      if (err.isFreeTierLimit) {
        onOpenPricing();
      } else {
        setErrorMsg(err.message || 'Crisis backroom simulation failed.');
      }
    } finally {
      setIsSimulating(false);
    }
  };

  const getFullCrisisText = () => {
    if (!feedback) return '';
    return `CRISIS DIRECTIVE: ${classification.toUpperCase()}
SENDER: Delegation of ${context.country}
RECIPIENT: ${recipient}
OBJECTIVE: ${objective}
DETAILS: ${actionDetails}
RESOURCES: ${resourcesNeeded}

=======================================================
CRISIS BACKROOM EVALUATION:
Realism: ${feedback.realismScore}/10 | Feasibility: ${feedback.feasibilityScore}/10 | Clarity: ${feedback.clarityScore}/10
Critique: ${feedback.analysis}

FALLOUT & BULLETIN:
Headline: ${feedback.backroomResponse?.newsHeadline || 'N/A'}
Verdict: ${feedback.backroomResponse?.verdict || 'N/A'}
Narrative: ${feedback.backroomResponse?.backroomNarrative || 'N/A'}`;
  };

  const handleCopy = async () => {
    const ok = await copyToClipboard(getFullCrisisText());
    if (ok) {
      setCopied(true);
      setTimeout(() => setCopied(false), 2000);
    }
  };

  return (
    <div className="space-y-6 max-w-6xl mx-auto">
      {/* Banner */}
      <div className="bg-white dark:bg-[#071326] p-5 sm:p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4 transition-colors">
        <div>
          <div className="flex items-center gap-2 text-rose-700 dark:text-rose-400 font-bold text-xs uppercase tracking-wider mb-1">
            <Flame className="w-4 h-4 text-rose-600 dark:text-rose-400" />
            <span>CRISIS CABINET DIRECTIVE & BACKROOM SIMULATOR</span>
          </div>
          <h2 className="text-xl sm:text-2xl font-bold text-[#0B1F3A] dark:text-white tracking-tight">
            Crisis Note Simulator
          </h2>
          <p className="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
            Draft covert or public directives, evaluate operational feasibility with AI Crisis Directors, and simulate backroom geopolitical fallout.
          </p>
        </div>

        {isFreeLimitHit && (
          <button
            id="btn-crisis-upgrade"
            onClick={onOpenPricing}
            className="px-4 py-2.5 min-h-[44px] bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 font-bold text-xs rounded-xl shadow-xs flex items-center gap-1.5 active:scale-98"
          >
            <Lock className="w-3.5 h-3.5" />
            <span>Upgrade to Simulate Crisis</span>
          </button>
        )}
      </div>

      {errorMsg && <ErrorAlert message={errorMsg} />}

      {/* Main Grid: Form on Left, Backroom Verdict on Right */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
        {/* Directive Drafting Form */}
        <div className="lg:col-span-5 space-y-4">
          <div className="bg-white dark:bg-[#071326] p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs space-y-4 transition-colors">
            <h3 className="font-bold text-slate-900 dark:text-slate-100 text-base">
              Crisis Directive Drafter
            </h3>

            {/* Classification */}
            <div>
              <label className="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">
                Classification Level
              </label>
              <div className="grid grid-cols-3 gap-2">
                {[
                  { id: 'covert', label: 'Covert Note', icon: EyeOff },
                  { id: 'public', label: 'Public Order', icon: Radio },
                  { id: 'directive', label: 'Cabinet Order', icon: FileText }
                ].map((c) => {
                  const Icon = c.icon;
                  return (
                    <button
                      key={c.id}
                      id={`btn-crisis-class-${c.id}`}
                      type="button"
                      onClick={() => setClassification(c.id as any)}
                      className={`p-2.5 min-h-[44px] rounded-xl border text-center text-xs font-bold transition-all flex flex-col items-center justify-center gap-1 ${
                        classification === c.id
                          ? 'bg-[#0B1F3A] dark:bg-[#D4AF37] text-[#D4AF37] dark:text-[#0B1F3A] border-[#0B1F3A] dark:border-[#D4AF37] shadow-xs'
                          : 'bg-white dark:bg-[#0b1b33] border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800'
                      }`}
                    >
                      <Icon className="w-4 h-4" />
                      <span>{c.label}</span>
                    </button>
                  );
                })}
              </div>
            </div>

            {/* Recipient */}
            <div>
              <label className="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
                Target Recipient / Asset
              </label>
              <input
                id="input-crisis-recipient"
                type="text"
                value={recipient}
                onChange={(e) => setRecipient(e.target.value)}
                placeholder="e.g. Chief of Police, Defense Attaché, Rebel Leader..."
                className="w-full px-3 py-2.5 min-h-[42px] text-xs border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-[#0B1F3A] dark:focus:ring-[#D4AF37] bg-white dark:bg-[#0b1b33] text-slate-800 dark:text-slate-100 font-medium"
              />
            </div>

            {/* Objective */}
            <div>
              <label className="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
                Strategic Objective
              </label>
              <input
                id="input-crisis-objective"
                type="text"
                value={objective}
                onChange={(e) => setObjective(e.target.value)}
                placeholder="Core goal of the directive"
                className="w-full px-3 py-2.5 min-h-[42px] text-xs border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-[#0B1F3A] dark:focus:ring-[#D4AF37] bg-white dark:bg-[#0b1b33] text-slate-800 dark:text-slate-100"
              />
            </div>

            {/* Action Details */}
            <div>
              <label className="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
                Operational Details & Protocol
              </label>
              <textarea
                id="textarea-crisis-details"
                rows={4}
                value={actionDetails}
                onChange={(e) => setActionDetails(e.target.value)}
                placeholder="Specify execution timeline, personnel involved, and failsafe measures..."
                className="w-full p-3 text-xs border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-[#0B1F3A] dark:focus:ring-[#D4AF37] bg-white dark:bg-[#0b1b33] text-slate-800 dark:text-slate-100 resize-none leading-relaxed"
              />
            </div>

            {/* Resources Needed */}
            <div>
              <label className="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
                Requisitioned Assets / Resources
              </label>
              <input
                id="input-crisis-resources"
                type="text"
                value={resourcesNeeded}
                onChange={(e) => setResourcesNeeded(e.target.value)}
                placeholder="Equipment, budget, personnel"
                className="w-full px-3 py-2.5 min-h-[42px] text-xs border border-slate-300 dark:border-slate-700 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-[#0B1F3A] dark:focus:ring-[#D4AF37] bg-white dark:bg-[#0b1b33] text-slate-800 dark:text-slate-100"
              />
            </div>

            <button
              id="btn-submit-crisis-directive"
              onClick={handleRunSimulation}
              disabled={isSimulating}
              className="w-full min-h-[44px] py-3 bg-[#0B1F3A] hover:bg-[#132c4f] dark:bg-[#0f2a4a] dark:hover:bg-[#153863] text-[#D4AF37] font-bold text-xs rounded-xl shadow-md transition-all flex items-center justify-center gap-2 border border-[#D4AF37]/30 disabled:opacity-50 active:scale-98"
            >
              {isSimulating ? (
                <>
                  <div className="w-4 h-4 border-2 border-[#D4AF37] border-t-transparent rounded-full animate-spin"></div>
                  <span>Crisis Backroom Simulating Fallout...</span>
                </>
              ) : (
                <>
                  <Flame className="w-4 h-4 fill-[#D4AF37]" />
                  <span>Submit to Crisis Backroom</span>
                </>
              )}
            </button>
          </div>
        </div>

        {/* Backroom Feedback / Fallout */}
        <div className="lg:col-span-7 space-y-4">
          <div className="bg-white dark:bg-[#071326] rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs p-5 min-h-[500px] flex flex-col justify-between transition-colors">
            <div>
              <div className="flex flex-wrap items-center justify-between pb-4 mb-4 border-b border-slate-200 dark:border-slate-800 gap-3">
                <div>
                  <h3 className="font-bold text-slate-900 dark:text-slate-100 text-base">
                    Crisis Backroom Verdict & Intelligence
                  </h3>
                  <p className="text-[11px] text-slate-500 dark:text-slate-400">
                    Realism scoring, operational loopholes, and simulated world updates
                  </p>
                </div>

                {feedback && (
                  <button
                    id="btn-crisis-copy"
                    onClick={handleCopy}
                    className="px-3 py-1.5 min-h-[38px] rounded-lg border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1 active:scale-98"
                  >
                    {copied ? <Check className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" /> : <Copy className="w-3.5 h-3.5" />}
                    <span>{copied ? 'Copied' : 'Copy'}</span>
                  </button>
                )}
              </div>

              {isSimulating ? (
                <div className="py-20 text-center space-y-3">
                  <div className="w-10 h-10 rounded-full border-3 border-rose-600 border-t-transparent animate-spin mx-auto"></div>
                  <h4 className="font-bold text-slate-800 dark:text-slate-200 text-sm">Evaluating Directive in Crisis Backroom...</h4>
                  <p className="text-xs text-slate-500 dark:text-slate-400">Checking timeline, radar countermeasures, and unintended diplomatic blowback.</p>
                </div>
              ) : feedback ? (
                <div className="space-y-4">
                  {/* Scores */}
                  <div className="grid grid-cols-3 gap-3">
                    <div className="p-3 rounded-xl bg-slate-50 dark:bg-[#0b1b33] border border-slate-200 dark:border-slate-800 text-center">
                      <span className="text-[10px] uppercase font-bold text-slate-400 dark:text-slate-500 block">Realism</span>
                      <span className="text-xl font-black text-[#0B1F3A] dark:text-blue-400">{feedback.realismScore || 8}/10</span>
                    </div>
                    <div className="p-3 rounded-xl bg-slate-50 dark:bg-[#0b1b33] border border-slate-200 dark:border-slate-800 text-center">
                      <span className="text-[10px] uppercase font-bold text-slate-400 dark:text-slate-500 block">Feasibility</span>
                      <span className="text-xl font-black text-amber-600 dark:text-amber-400">{feedback.feasibilityScore || 7}/10</span>
                    </div>
                    <div className="p-3 rounded-xl bg-slate-50 dark:bg-[#0b1b33] border border-slate-200 dark:border-slate-800 text-center">
                      <span className="text-[10px] uppercase font-bold text-slate-400 dark:text-slate-500 block">Clarity</span>
                      <span className="text-xl font-black text-emerald-600 dark:text-emerald-400">{feedback.clarityScore || 9}/10</span>
                    </div>
                  </div>

                  {/* Crisis Director's Critique */}
                  <div className="p-4 rounded-xl bg-slate-50 dark:bg-[#0b1b33] border border-slate-200 dark:border-slate-800 text-xs space-y-2">
                    <span className="font-bold uppercase tracking-wider text-[11px] text-slate-700 dark:text-slate-300 block">
                      Crisis Director Operational Analysis:
                    </span>
                    <p className="text-slate-700 dark:text-slate-300 leading-relaxed">{feedback.analysis}</p>
                  </div>

                  {/* Operational Flaws & Vulnerabilities */}
                  {feedback.vulnerabilities && (
                    <div className="p-4 rounded-xl bg-rose-50/60 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/50 text-xs space-y-1.5">
                      <span className="font-bold uppercase tracking-wider text-[11px] text-rose-800 dark:text-rose-300 block">
                        Identified Loopholes / Risks:
                      </span>
                      {feedback.vulnerabilities.map((v: string, i: number) => (
                        <div key={i} className="flex items-start gap-2 text-rose-900 dark:text-rose-200">
                          <span className="text-rose-600 dark:text-rose-400 font-bold shrink-0">⚠️</span>
                          <span>{v}</span>
                        </div>
                      ))}
                    </div>
                  )}

                  {/* Simulated In-Universe Fallout Bulletin */}
                  {feedback.backroomResponse && (
                    <div className="p-4 rounded-xl bg-[#0B1F3A] dark:bg-[#050f1e] text-white space-y-2.5 border-l-4 border-[#D4AF37]">
                      <div className="flex items-center justify-between">
                        <span className="text-[10px] uppercase font-bold tracking-widest text-[#D4AF37]">
                          IN-UNIVERSE CRISIS UPDATE
                        </span>
                        <span className="text-[10px] px-2 py-0.5 rounded-full bg-white/10 font-bold">
                          Verdict: {feedback.backroomResponse.verdict}
                        </span>
                      </div>
                      <h4 className="font-bold text-sm text-white">
                        {feedback.backroomResponse.newsHeadline}
                      </h4>
                      <p className="text-xs text-slate-300 leading-relaxed">
                        {feedback.backroomResponse.backroomNarrative}
                      </p>
                    </div>
                  )}
                </div>
              ) : (
                <div className="py-20 text-center text-slate-400 dark:text-slate-500">
                  <Flame className="w-12 h-12 stroke-1 text-slate-300 dark:text-slate-600 mx-auto mb-2" />
                  <p className="font-bold text-slate-700 dark:text-slate-300 text-sm">No Directive Submitted Yet</p>
                  <p className="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-sm mx-auto">
                    Fill out the directive form on the left to test your crisis note against the AI Crisis Director.
                  </p>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};
