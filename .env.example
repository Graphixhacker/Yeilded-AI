# GEMINI_API_KEY: Fallback AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: Required for DeepSeek chat completions (https://platform.deepseek.com).
# If not set, system falls back to configured AI service.
DEEPSEEK_API_KEY=""

# VITE_GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Client ID for Google Sign-In button
VITE_GOOGLE_CLIENT_ID=""

# APP_URL: Base URL used to construct password reset links (defaults to current origin or https://yeilded.ai.studio)
APP_URL=""

# Email Service Configuration (Nodemailer SMTP)
# If unset, password reset links are logged to the server console in development
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Yeilded <support@yeilded.com>"

